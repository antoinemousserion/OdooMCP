# Copier ce fichier en .env et adapter les valeurs

# Token GitHub avec accès au repo privé odoo/enterprise
# Créer un PAT : https://github.com/settings/tokens
#
# Prérequis côté Odoo : votre compte GitHub doit être autorisé sur odoo/enterprise
# (via le portail partenaire Odoo ou votre abonnement Enterprise).
#
# --- PAT classique (recommandé, le plus simple) ---
# Scopes à cocher :
#   - repo   (accès complet aux dépôts privés — nécessaire pour cloner odoo/enterprise)
#
# --- PAT fine-grained (alternative) ---
# Resource owner : votre compte ou l'organisation odoo (si visible)
# Repository access : Only select repositories → odoo/enterprise
# Permissions :
#   - Contents : Read-only
#   - Metadata : Read-only (souvent implicite)
GITHUB_TOKEN=

# Volume local où sont stockées les codebases Odoo clonées
# Structure : v18/community, v18/enterprise, v17/community, etc.
# Sous Windows, préférer les slashes : C:/Users/.../MCP Odoo
ODOO_VOLUME_PATH=C:/dossier/du/volume

# Versions Odoo a demarrer automatiquement au boot (tache planifiee + restart: always)
# Liste separee par virgules ; chaque version = service odoo-mcp-vXX
ODOO_VERSIONS=17,18,19

# Port de base pour les serveurs MCP SSE (v18 = 8018, v17 = 8017, etc.)
MCP_PORT_BASE=8000

# Cloner enterprise (nécessite GITHUB_TOKEN valide)
CLONE_ENTERPRISE=true

# Profondeur du clone initial (1 = rapide, augmenter pour l'historique git)
GIT_DEPTH=1
